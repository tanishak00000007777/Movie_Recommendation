# ------------------- Helper Functions ------------------- #
def ocean_spinner_msg():
    return random.choice([
        "Diving into the data... 🏊‍♀️",
        "Scanning the seas for answers... 🌊",
        "Surfacing amazing patterns... 🐬",
        "Exploring the depths... 🐙",
        "Looking through coral reefs... 🪸"
    ])

def friendly_error(exc: Exception) -> str:
    # FIX 2: Accept the real exception so we can log it to sidebar for debugging,
    # while still showing a friendly message to the user.
    st.sidebar.error(f"🐛 Debug: {exc}", icon="🔍")
    return random.choice([
        "Oops! The ocean data is being shy. Let's try again! 😊",
        "Hmm, no waves detected. Want to try a different question?",
        "The currents are a bit mysterious today. Give it another go! 🌊",
        "Sorry, the ocean critters are hiding the data right now. 🦑"
    ])

def ai_personality_intro():
    return random.choice([
        "Great question! 🌟",
        "This is fascinating! 🐠",
        "Look what I found! 🔍",
        "Awesome curiosity! 🌊",
        "Let's dive into this together! 🤿"
    ])

# ------------------- Ocean Data ------------------- #
def get_ocean_data(query):
    q = query.lower()
    if "temperature" in q:
        df = pd.DataFrame({
            "Latitude": list(range(-90, 91, 10)),
            "Sea Surface Temp (°C)": [27 - abs(lat) / 15 + random.uniform(-1, 1) for lat in range(-90, 91, 10)]
        })
        fig = px.line(df, x="Latitude", y="Sea Surface Temp (°C)",
                      title="Sea Surface Temperature by Latitude",
                      color_discrete_sequence=["#06b6d4"])
        explanation = f"{ai_personality_intro()} The warmest waters hug the equator, while polar regions stay chilly. Notice the temperature peak near 0° latitude! 🌡"
        details = "Data: Simulated from global ocean observations. Near the equator, solar heating keeps waters warm year-round, whereas at the poles, sea ice and less sunlight cool the surface."
        return explanation, fig, df, details

    elif "saltiest" in q or "salinity" in q:
        df = pd.DataFrame({
            "Location": ["Atlantic", "Pacific", "Indian", "Southern", "Arctic"],
            "Avg Salinity (PSU)": [36.5, 34.7, 35.1, 34.6, 30.0]
        })
        fig = px.bar(df, x="Location", y="Avg Salinity (PSU)", color="Location",
                     color_discrete_sequence=["#f97316", "#06b6d4", "#1e3a8a", "#bae6fd", "#e0f2fe"])
        explanation = f"{ai_personality_intro()} The Atlantic Ocean is the saltiest—it's like the ocean's 'salt shaker'! 🧂"
        details = "Salinity varies due to evaporation, rainfall, and river inflow. The Atlantic has high evaporation and less freshwater input, making it saltier than others."
        return explanation, fig, df, details

    elif "oxygen" in q:
        df = pd.DataFrame({
            "Year": list(range(2000, 2024)),
            "O2 (mg/L)": [7.5 - 0.01 * (y - 2000) + random.uniform(-0.02, 0.02) for y in range(2000, 2024)]
        })
        fig = px.line(df, x="Year", y="O2 (mg/L)", title="Average Ocean Oxygen Over Time",
                      color_discrete_sequence=["#1e3a8a"])
        explanation = f"{ai_personality_intro()} Oxygen levels are gently declining—a pattern scientists watch closely. 🫧"
        details = "Oxygen is vital for marine life. Warming waters hold less O2, and nutrient runoff can cause low-oxygen zones."
        return explanation, fig, df, details

    elif "deepest" in q:
        df = pd.DataFrame({
            "Trench": ["Mariana", "Tonga", "Philippine", "Kuril-Kamchatka"],
            "Depth (m)": [10984, 10882, 10540, 9780]
        })
        fig = px.bar(df, x="Trench", y="Depth (m)", color="Trench",
                     color_discrete_sequence=["#1e3a8a", "#06b6d4", "#bae6fd", "#f97316"])
        explanation = f"{ai_personality_intro()} The Mariana Trench dives deeper than Mount Everest is tall! 🕳"
        details = "These trenches are formed by tectonic subduction. The Mariana Trench is the ocean's deepest known point at ~11,000 meters."
        return explanation, fig, df, details

    elif "surprise" in q:
        facts = [
            "Did you know? The ocean covers 71% of Earth's surface! 🌎",
            "There are more life forms in the ocean than on land—many still undiscovered! 🐙",
            "Underwater mountains (seamounts) are more numerous than those on land! 🏔",
            "Bioluminescent creatures light up the deep sea like stars. ✨",
            "Ocean currents move more water than all the world's rivers combined! 🌊"
        ]
        explanation = f"{ai_personality_intro()} {random.choice(facts)}"
        details = "Surprise facts are sourced from marine science literature and oceanographic databases."
        return explanation, None, None, details

    else:
        # FIX 3: Raise a descriptive error instead of a generic ValueError so
        # the catch block can surface a useful debug message.
        raise ValueError(f"Query '{query}' did not match any topic keyword (temperature / salinity / oxygen / deepest / surprise).")

