# ------------------- Main Chat UI ------------------- #
# Display full chat history
for msg in st.session_state.chat_history:
    if msg["role"] == "user":
        with st.chat_message("user", avatar="🐠"):
            st.markdown(f'<div class="chat-bubble-user">{msg["content"]}</div>', unsafe_allow_html=True)
    else:
        with st.chat_message("assistant", avatar="🧑‍🔬"):
            st.markdown(f'<div class="chat-bubble-ai">{msg["content"]}</div>', unsafe_allow_html=True)
            # FIX 4: Guard with .get() — old history entries may not have "fig"/"df" keys,
            # causing a KeyError crash when the chat history is replayed after rerun.
            if msg.get("fig") is not None:
                st.plotly_chart(msg["fig"], use_container_width=True)
            if msg.get("df") is not None:
                with st.expander("📊 See raw data & technical notes"):
                    st.dataframe(msg["df"], use_container_width=True)
                    st.info(msg.get("details", ""), icon="🌊")

# ------------------- Resolve active query ------------------- #
# Priority: pending sidebar click > typed chat input
user_query = st.session_state.pending_query
st.session_state.pending_query = None   # consume it immediately

if not user_query:
    user_query = st.chat_input("What ocean mystery can I help you solve today? 🐠")

# ------------------- Process query ------------------- #
if user_query:
    st.session_state.chat_history.append({"role": "user", "content": user_query})

    with st.chat_message("assistant", avatar="🧑‍🔬"):
        with st.spinner(ocean_spinner_msg()):
            time.sleep(1.4)
            try:
                explanation, fig, df, details = get_ocean_data(user_query)
                st.session_state.chat_history.append({
                    "role": "assistant",
                    "content": explanation,
                    "fig": fig,
                    "df": df,
                    "details": details,
                })
                st.markdown(f'<div class="chat-bubble-ai">{explanation}</div>', unsafe_allow_html=True)
                if fig is not None:
                    st.plotly_chart(fig, use_container_width=True)
                if df is not None:
                    with st.expander("📊 See raw data & technical notes"):
                        st.dataframe(df, use_container_width=True)
                        st.info(details, icon="🌊")
                st.success("🎉 Found some amazing patterns for you!", icon="✨")

            except Exception as e:
                err_msg = friendly_error(e)   # FIX 2: pass exception
                st.session_state.chat_history.append({
                    "role": "assistant",
                    "content": err_msg,
                })
                st.markdown(f'<div class="chat-bubble-ai">{err_msg}</div>', unsafe_allow_html=True)
                st.info("Try rewording your question or pick an example from the sidebar!", icon="💡")

